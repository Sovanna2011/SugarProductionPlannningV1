# ---------------------------------------------------------------------------
# Sugar Production Planning — backend configuration
# Copy to .env for local development. Real environments inject these values.
# ---------------------------------------------------------------------------

APP_ENV=DEV                     # DEV | SIT | UAT | PRD
HTTP_ADDR=:8080
LOG_LEVEL=info                  # trace | debug | info | warn | error

# --- database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=sugar
DB_PASSWORD=sugar
DB_NAME=sugar_dev
DB_SSLMODE=disable              # must not be 'disable' in PRD
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_SLOW_QUERY_THRESHOLD=500ms
DB_AUTO_MIGRATE=true            # DEV/SIT only; UAT/PRD migrate by a controlled job
MIGRATE_INCLUDE_DEMO=true       # must be false in PRD

# --- authentication --------------------------------------------------------
# Each environment gets its own signing key (§A5). At least 32 characters in PRD.
JWT_SECRET=change-me-in-every-environment
JWT_ISSUER=sugar-planning
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h

PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
PERMISSION_CACHE_TTL=60s
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m

# --- first start -----------------------------------------------------------
# The administrator is created on first boot and must change the password at
# first login. Required in PRD — the service refuses to start without it.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_USERS=true            # must be false in PRD
DEMO_USER_PASSWORD=SugarPlanning#2026

# --- business rules --------------------------------------------------------
ENFORCE_FOUR_EYES=true          # OQ-5: the approver must not be the creator
MAX_FUTURE_POSTING_DAYS=1
CAPACITY_AMBER_PCT=70           # §F5 traffic lights
CAPACITY_RED_PCT=90

# --- data browser safety rails (Part G) ------------------------------------
BROWSER_ROW_CAP=10000
BROWSER_EXPORT_CAP=100000
BROWSER_STATEMENT_TIMEOUT=30s

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8081
