<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">

	<Dialog title="{i18n>newDocument}" contentWidth="34rem">
		<f:SimpleForm layout="ResponsiveGridLayout" editable="true"
			labelSpanL="4" labelSpanM="4" columnsL="1" columnsM="1">

			<Label text="{i18n>movementType}" required="true"/>
			<ComboBox selectedKey="{view>/entry/movementTypeId}" items="{view>/movementTypes}">
				<core:Item key="{view>id}" text="{view>movementName}"/>
			</ComboBox>

			<Label text="{i18n>postingDate}" required="true"/>
			<DatePicker value="{view>/entry/postingDate}" valueFormat="yyyy-MM-dd"
				displayFormat="yyyy-MM-dd"/>

			<Label text="{i18n>description}"/>
			<Input value="{view>/entry/description}"/>

			<Label text="{i18n>productionLine}"/>
			<ComboBox selectedKey="{view>/entry/productionLineId}" items="{view>/lines}">
				<core:Item key="{view>id}" text="{view>lineCode} — {view>lineName}"/>
			</ComboBox>

			<Label text="{i18n>material}" required="true"/>
			<ComboBox selectedKey="{view>/entry/materialId}" items="{view>/materials}"
				change=".onMaterialSelected">
				<core:Item key="{view>id}" text="{view>materialCode} — {view>materialName}"/>
			</ComboBox>

			<Label text="{i18n>process}"/>
			<ComboBox selectedKey="{view>/entry/processId}" items="{view>/processes}">
				<core:Item key="{view>id}" text="{view>processCode}"/>
			</ComboBox>

			<Label text="{i18n>warehouse}"/>
			<ComboBox selectedKey="{view>/entry/warehouseId}" items="{view>/warehouses}">
				<core:Item key="{view>id}" text="{view>warehouseCode} — {view>warehouseName}"/>
			</ComboBox>

			<Label text="{i18n>quantity}" required="true"/>
			<Input value="{view>/entry/quantity}" type="Number" textAlign="End"/>
		</f:SimpleForm>

		<beginButton>
			<Button text="{i18n>save}" type="Emphasized" press=".onDialogSave"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>cancel}" press=".onDialogCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
