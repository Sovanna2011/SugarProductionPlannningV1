<mvc:View
	controllerName="sugar.planning.controller.ActualEntry"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc">

	<Page title="{i18n>actualTitle}" showNavButton="true" navButtonPress=".onNavBack">
		<headerContent>
			<Button icon="sap-icon://log" tooltip="{i18n>signOut}" press=".onLogout"/>
		</headerContent>

		<subHeader>
			<OverflowToolbar>
				<Label text="{i18n>company}" required="true"/>
				<ComboBox selectedKey="{view>/companyId}" items="{app>/companies}"
					change=".onCompanyChange" width="16rem">
					<core:Item key="{app>companyId}" text="{app>companyCode} — {app>companyName}"/>
				</ComboBox>

				<Label text="{i18n>dateFrom}"/>
				<DatePicker value="{view>/dateFrom}" valueFormat="yyyy-MM-dd"
					displayFormat="yyyy-MM-dd" width="9rem"/>
				<Label text="{i18n>dateTo}"/>
				<DatePicker value="{view>/dateTo}" valueFormat="yyyy-MM-dd"
					displayFormat="yyyy-MM-dd" width="9rem"/>

				<ToolbarSpacer/>
				<Button text="{i18n>load}" icon="sap-icon://refresh" press=".onLoad"/>
				<Button text="{i18n>newDocument}" icon="sap-icon://add" type="Emphasized"
					press=".onNew" enabled="{view>/canCreate}"/>
			</OverflowToolbar>
		</subHeader>

		<VBox class="sapUiSmallMargin">
			<MessageStrip visible="{= !!${view>/message} }" text="{view>/message}"
				type="{view>/messageType}" showIcon="true" class="sapUiSmallMarginBottom"/>

			<Table items="{view>/documents}" noDataText="{i18n>noDocuments}">
				<columns>
					<Column><Text text="{i18n>documentNo}"/></Column>
					<Column><Text text="{i18n>postingDate}"/></Column>
					<Column><Text text="{i18n>description}"/></Column>
					<Column><Text text="{i18n>status}"/></Column>
					<Column hAlign="End"><Text text="{i18n>actions}"/></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier title="{view>documentNo}"/>
							<Text text="{view>postingDate}"/>
							<Text text="{view>description}"/>
							<ObjectStatus text="{view>postingStatus}"
								state="{path: 'view>postingStatus', formatter: '.formatter.postingState'}"/>
							<HBox justifyContent="End">
								<Button text="{i18n>post}" type="Emphasized" press=".onPost"
									enabled="{= ${view>postingStatus} === 'DRAFT' &amp;&amp; ${view>/canPost} }"
									class="sapUiTinyMarginEnd"/>
								<Button text="{i18n>reverse}" press=".onReverse"
									enabled="{= ${view>postingStatus} === 'POSTED' &amp;&amp; ${view>/canReverse} }"/>
							</HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</VBox>
	</Page>
</mvc:View>
